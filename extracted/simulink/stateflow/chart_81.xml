        <P Name="script">function img_out = drawLines(img_in, pts, color)

% Draw lines connecting the points using the provided color

% Inputs:
% img_in    : Input RGB Image (size = m by n)
% pts       : p x-y pairs of points (px) where markers are to be drawn
% color     : 1x3 matrix of RGB color values for each marker

% Outputs:
% img_out   : Output RGB Image with the markers drawn in (size = m by n)

%% Initialization
if size(img_in, 3) == 3
    img_out = img_in;
elseif size(img_in, 3) == 1
    img_out = cat(3, img_in, img_in, img_in);
end

[p, ~] = size(pts); % determine the number of points

%% Draw the lines
    for i = 1:p-1
        % determine the max(rows_difference, col_difference) between two
        % points
        itr = max(abs(pts(i,1) - pts(i+1,1)), abs(pts(i,2) - pts(i+1,2)));
        
        % generate linear spaces of row and col values between the pts
        row_vec = round(linspace(pts(i,1), pts(i+1,1), itr));
        col_vec = round(linspace(pts(i,2), pts(i+1,2), itr));
        
        % iterate through the values and shade them right

        for j = 1:itr
            img_out(row_vec(j), col_vec(j),1) = color(1);
            img_out(row_vec(j), col_vec(j),2) = color(2);
            img_out(row_vec(j), col_vec(j),3) = color(3);
        end
    end
end</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
